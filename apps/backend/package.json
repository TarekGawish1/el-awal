{
  "name": "@el-awal/backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "postinstall": "bun x prisma generate",
    "prebuild": "bun -e \"try { require('fs').rmSync('dist', { recursive: true, force: true }); } catch (e) {}\"",
    "build": "bun x nest build",
    "heroku-postbuild": "bun x prisma generate && bun run build",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "bun x nest start",
    "dev": "bun x nest start --watch",
    "start:dev": "bun x nest start --watch",
    "start:debug": "bun x nest start --debug --watch",
    "start:prod": "bun dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "prisma:generate": "bun x prisma generate",
    "prisma:migrate": "bun x prisma migrate dev",
    "prisma:migrate:deploy": "bun x prisma migrate deploy",
    "prisma:studio": "bun x prisma studio",
    "prisma:seed": "bun prisma/seed.ts",
    "storage:clean": "bun scripts/clean-storage.ts",
    "storage:clean:dry": "bun scripts/clean-storage.ts --dry-run",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "vitest run test/app.e2e-spec.ts"
  },
  "packageManager": "bun@1.4.2",
  "prisma": {
    "seed": "bun prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.637.0",
    "@aws-sdk/s3-request-presigner": "^3.637.0",
    "@fastify/compress": "^9.2.1",
    "@fastify/cookie": "^11.1.3",
    "@fastify/helmet": "^13.1.2",
    "@fastify/multipart": "^10.1.3",
    "@fastify/static": "^10.1.6",
    "@nestjs/cli": "^12.0.8",
    "@nestjs/common": "^12.1.2",
    "@nestjs/config": "^12.0.1",
    "@nestjs/core": "^12.1.2",
    "@nestjs/event-emitter": "^12.0.1",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-express": "^12.1.2",
    "@nestjs/platform-fastify": "^12.1.3",
    "@nestjs/platform-socket.io": "^12.1.2",
    "@nestjs/schematics": "^12.0.7",
    "@nestjs/swagger": "^12.0.2",
    "@nestjs/terminus": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.1.2",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/pdfkit": "^0.17.6",
    "@types/qrcode": "^1.5.6",
    "@types/web-push": "^3.6.4",
    "@upstash/redis": "^1.39.0",
    "@whiskeysockets/baileys": "^7.0.0-rc14",
    "arabic-persian-reshaper": "^1.0.1",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.2",
    "cookie-parser": "^1.4.7",
    "fastify": "^5.12.5",
    "firebase-admin": "^14.5.0",
    "geoip-lite": "^2.0.3",
    "helmet": "^8.3.0",
    "node-cron": "^4.6.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.20.2",
    "pg": "^8.13.3",
    "prisma": "^7.10.0",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.3",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.2",
    "web-push": "^3.6.7",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@nestjs/testing": "^12.1.2",
    "@swc/core": "^1.16.18",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.8.1",
    "@types/cookie-parser": "^1.4.10",
    "@types/express": "^4.17.21",
    "@types/geoip-lite": "^1.4.4",
    "@types/jest": "^29.5.12",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.14.12",
    "@types/passport-jwt": "^4.0.1",
    "@types/pg": "^8.11.11",
    "@types/supertest": "^6.0.2",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.4",
    "unplugin-swc": "^2.0.0",
    "vitest": "^3.2.7"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
