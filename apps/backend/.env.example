# ==============================================================================
# EL AWAL EDUCATIONAL MANAGEMENT PLATFORM — BACKEND CONFIGURATION TEMPLATE
# Copy to .env and populate with deployment credentials
# ==============================================================================

# Server Runtime
NODE_ENV=development
PORT=3000
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://127.0.0.1:3000,http://127.0.0.1:3001

# PostgreSQL Database (Neon / Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/el_awal_db?schema=public"

# Authentication & Cryptographic Tokens
JWT_SECRET="replace-with-a-random-32-character-or-longer-secret-key"
JWT_EXPIRES_IN="7d"

# Cloudflare R2 Object Storage (Documents, PDFs, Homework, Avatars)
R2_ACCOUNT_ID="your_cloudflare_account_id"
R2_ACCESS_KEY_ID="your_r2_access_key_id"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key"
R2_BUCKET_NAME="el-awal-assets"
R2_PUBLIC_URL="https://assets.elawal.com"

# Bunny Stream Video Cloud (DRM Transcoding, Encrypted HLS, Secure Player)
BUNNY_API_KEY="your_bunny_api_key"
BUNNY_LIBRARY_ID="your_bunny_library_id"
BUNNY_CDN_HOSTNAME="vz-xxxxxx.b-cdn.net"
BUNNY_TOKEN_SECURITY_KEY="your_bunny_token_auth_security_key"
