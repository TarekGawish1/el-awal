# El-Awal Backend — Environment Variables Reference
# Copy this file to .env and fill in the values

# ─── Core ──────────────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=3000

# ─── Database (PostgreSQL / Neon / Supabase) ──────────────────────────────────
DATABASE_URL=postgresql://user:password@host:5432/dbname?sslmode=require
# Optional direct URL (used by Prisma migrate). Same as DATABASE_URL for Heroku PG.
DIRECT_URL=postgresql://user:password@host:5432/dbname?sslmode=require

# ─── Authentication ────────────────────────────────────────────────────────────
JWT_ACCESS_SECRET=your-access-secret-at-least-32-chars
JWT_REFRESH_SECRET=your-refresh-secret-at-least-32-chars-different-from-access
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── CORS ──────────────────────────────────────────────────────────────────────
CORS_ORIGINS=https://your-web-app.vercel.app,https://your-app.herokuapp.com

# ─── Cloudflare R2 Storage ─────────────────────────────────────────────────────
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=
R2_PUBLIC_URL=

# ─── Bunny Stream Video ────────────────────────────────────────────────────────
BUNNY_API_KEY=
BUNNY_LIBRARY_ID=
BUNNY_CDN_HOSTNAME=
BUNNY_TOKEN_SECURITY_KEY=

# ─── Web Push Notifications (VAPID) ───────────────────────────────────────────
# Generate once with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@elawal.com

# ─── WhatsApp (Baileys & Anti-Ban Rate Limiting) ──────────────────────────────
# Set to false to disable WhatsApp integration entirely
WHATSAPP_ENABLED=true
# Anti-ban velocity throttles: max messages per rolling 60-minute window (default: 25)
WHATSAPP_HOURLY_LIMIT=25
# Anti-ban daily volume ceiling (default: 80)
WHATSAPP_DAILY_LIMIT=80

# ─── Frontend URL (for deep links in push notifications) ──────────────────────
NEXT_PUBLIC_APP_URL=https://your-web-app.vercel.app

# ─── Operational ──────────────────────────────────────────────────────────────
ENABLE_SWAGGER=false
TRUST_PROXY=true
