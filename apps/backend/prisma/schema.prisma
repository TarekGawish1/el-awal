// Prisma Schema for El Awal Educational Management System
// Target Database: PostgreSQL 16+ (Neon Cloud)
// Architecture: Modular Monolith with Offline-First Sync Support

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ==========================================
// 1. ENUMS (Static Domain States)
// ==========================================

enum UserRole {
  TEACHER
  STUDENT
  PARENT
  SECRETARIAT

  @@map("user_role")
}

enum StudentAcademicStatus {
  ACTIVE
  SUSPENDED
  GRADUATED
  ARCHIVED

  @@map("student_academic_status")
}

enum GroupEnrollmentStatus {
  ACTIVE
  TRANSFERRED
  DROPPED

  @@map("group_enrollment_status")
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  EXCUSED

  @@map("attendance_status")
}

enum RecordingMethod {
  QR_SCAN
  MANUAL

  @@map("recording_method")
}

enum CourseStatus {
  DRAFT
  PUBLISHED
  ARCHIVED

  @@map("course_status")
}

enum CourseEnrollmentStatus {
  ACTIVE
  COMPLETED
  DROPPED

  @@map("course_enrollment_status")
}

enum CourseAccessStatus {
  ACTIVE
  EXPIRED
  SUSPENDED

  @@map("course_access_status")
}

enum ContentType {
  FILE
  SUMMARY
  REFERENCE
  LECTURE_RECORDING

  @@map("content_type")
}

enum AssessmentType {
  ASSIGNMENT
  EXAM

  @@map("assessment_type")
}

enum QuestionType {
  MULTIPLE_CHOICE
  TRUE_FALSE
  ESSAY

  @@map("question_type")
}

enum SubmissionStatus {
  SUBMITTED
  GRADED
  UNSOLVED

  @@map("submission_status")
}

enum PaymentStatus {
  PENDING
  PAID
  OVERDUE
  EXEMPT
  REFUNDED

  @@map("payment_status")
}

enum PaymentType {
  TUITION
  BOOKLET
  OTHER

  @@map("payment_type")
}

// ==========================================
// 2. USERS & IDENTITY DOMAIN
// ==========================================

model User {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  fullName     String    @map("full_name") @db.VarChar(200)
  phone        String?   @unique(map: "uq_users_phone") @map("phone") @db.VarChar(30)
  email        String?   @unique(map: "uq_users_email") @map("email") @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  role         UserRole  @map("role")
  isActive     Boolean   @default(true) @map("is_active")
  deletedAt    DateTime? @map("deleted_at") @db.Timestamptz(6)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  // 1:1 Profile Extensions
  teacherProfile     TeacherProfile?
  studentProfile     StudentProfile?
  parentProfile      ParentProfile?
  secretariatProfile SecretariatProfile?

  // Recorded Operations & Audits
  recordedAttendances   AttendanceRecord[]     @relation("RecordedAttendances")
  grantedCourseAccesses CourseAccess[]         @relation("GrantedCourseAccesses")
  recordedPayments      StudentPaymentRecord[] @relation("RecordedPayments")
  notifications         Notification[]         @relation("UserNotifications")
  refreshTokenSessions  RefreshTokenSession[]

  @@index([role], map: "idx_users_role")
  @@index([phone], map: "idx_users_phone")
  @@map("users")
}

model RefreshTokenSession {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique(map: "uq_refresh_sessions_token_hash") @map("token_hash") @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt    DateTime? @map("revoked_at") @db.Timestamptz(6)
  replacedById String?   @map("replaced_by_id") @db.Uuid
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt, expiresAt], map: "idx_refresh_sessions_user_active")
  @@index([expiresAt], map: "idx_refresh_sessions_expiry")
  @@map("refresh_token_sessions")
}

model TeacherProfile {
  id                 String   @id @map("id") @db.Uuid
  specialty          String?  @map("specialty") @db.VarChar(100)
  bio                String?  @map("bio") @db.Text
  activeAcademicYear String?  @default("2026-2027") @map("active_academic_year") @db.VarChar(30)
  activeAcademicTerm String?  @default("FIRST_TERM") @map("active_academic_term") @db.VarChar(30)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  // Authored Domain Entities
  academicGroups      AcademicGroup[]
  courses             Course[]
  educationalContents EducationalContent[]
  assessments         Assessment[]
  studentEvaluations  StudentEvaluation[]
  booklets            Booklet[]

  @@map("teacher_profiles")
}

model StudentProfile {
  id             String                @id @map("id") @db.Uuid
  studentCode    String?               @unique(map: "uq_students_code") @map("student_code") @db.VarChar(50)
  qrCodeToken    String                @unique(map: "uq_student_qr_code") @map("qr_code_token") @db.VarChar(255)
  gradeLevel     String                @map("grade_level") @db.VarChar(50)
  academicStage  String?               @map("academic_stage") @db.VarChar(50)
  academicStatus StudentAcademicStatus @default(ACTIVE) @map("academic_status")
  dateOfBirth    DateTime?             @map("date_of_birth") @db.Date
  emergencyPhone String?               @map("emergency_phone") @db.VarChar(30)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  // Student Linkages & Academic History
  parentLinks           ParentStudentLink[]
  groupEnrollments      GroupEnrollment[]
  attendanceRecords     AttendanceRecord[]
  courseEnrollments     CourseEnrollment[]
  courseProgresses      CourseProgress[]
  contentProgresses     ContentProgress[]
  assessmentSubmissions AssessmentSubmission[]
  studentEvaluations    StudentEvaluation[]
  paymentRecords        StudentPaymentRecord[]
  lessonQuestions       LessonQuestion[]

  @@index([qrCodeToken], map: "idx_students_qr_code")
  @@index([gradeLevel], map: "idx_students_grade_level")
  @@map("student_profiles")
}

model ParentProfile {
  id               String   @id @map("id") @db.Uuid
  relationshipType String?  @map("relationship_type") @db.VarChar(50)
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  studentLinks ParentStudentLink[]

  @@map("parent_profiles")
}

model SecretariatProfile {
  id         String   @id @map("id") @db.Uuid
  staffTitle String?  @map("staff_title") @db.VarChar(100)
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("secretariat_profiles")
}

model ParentStudentLink {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  parentId  String   @map("parent_id") @db.Uuid
  studentId String   @map("student_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  parent  ParentProfile  @relation(fields: [parentId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([parentId, studentId], map: "uq_parent_student")
  @@index([studentId], map: "idx_parent_student_student")
  @@index([parentId], map: "idx_parent_student_parent")
  @@map("parent_student_links")
}

// ==========================================
// 3. PHYSICAL LEARNING DOMAIN
// ==========================================

model AcademicGroup {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  name         String   @map("name") @db.VarChar(150)
  academicYear String   @default("2026-2027") @map("academic_year") @db.VarChar(20)
  academicTerm String   @default("FIRST_TERM") @map("academic_term") @db.VarChar(30)
  gradeLevel   String   @map("grade_level") @db.VarChar(50)
  description  String?  @map("description") @db.Text
  maxCapacity  Int      @default(50) @map("max_capacity")
  monthlyFee   Decimal  @default(0.00) @map("monthly_fee") @db.Decimal(10, 2)
  teacherId    String   @map("teacher_id") @db.Uuid
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)

  enrollments         GroupEnrollment[]
  schedules           LessonSchedule[]
  sessions            LessonSession[]
  educationalContents EducationalContent[]
  assessments         Assessment[]
  targetAssessments   Assessment[] @relation("AssessmentTargetGroups")
  studentEvaluations  StudentEvaluation[]
  paymentRecords      StudentPaymentRecord[]
  booklets            Booklet[]
  courseAccess        GroupCourseAccess[]

  @@index([teacherId], map: "idx_groups_teacher")
  @@index([gradeLevel, isActive], map: "idx_groups_grade_active")
  @@index([academicYear, academicTerm, teacherId], map: "idx_groups_year_term_teacher")
  @@map("academic_groups")
}

model GroupEnrollment {
  id         String                @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  groupId    String                @map("group_id") @db.Uuid
  studentId  String                @map("student_id") @db.Uuid
  enrolledAt DateTime              @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  status     GroupEnrollmentStatus @default(ACTIVE) @map("status")

  group   AcademicGroup  @relation(fields: [groupId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([groupId, studentId], map: "uq_group_student")
  @@index([studentId, status], map: "idx_enrollments_student")
  @@index([groupId, status], map: "idx_group_enrollments_group_status")
  @@map("group_enrollments")
}

model LessonSchedule {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  groupId   String  @map("group_id") @db.Uuid
  dayOfWeek Int     @map("day_of_week") @db.SmallInt
  startTime String  @map("start_time") @db.VarChar(10)
  endTime   String  @map("end_time") @db.VarChar(10)
  location  String? @map("location") @db.VarChar(150)

  group    AcademicGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  sessions LessonSession[]

  @@index([groupId], map: "idx_schedules_group")
  @@map("lesson_schedules")
}

model LessonSession {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  groupId     String   @map("group_id") @db.Uuid
  scheduleId  String?  @map("schedule_id") @db.Uuid
  sessionDate DateTime @map("session_date") @db.Date
  startTime   String?  @map("start_time") @db.VarChar(10)
  endTime     String?  @map("end_time") @db.VarChar(10)
  topic              String?  @map("topic") @db.VarChar(255)
  isCancelled        Boolean  @default(false) @map("is_cancelled")
  cancellationReason String?  @map("cancellation_reason") @db.Text
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  group    AcademicGroup   @relation(fields: [groupId], references: [id], onDelete: Cascade)
  schedule LessonSchedule? @relation(fields: [scheduleId], references: [id], onDelete: SetNull)

  attendanceRecords   AttendanceRecord[]
  educationalContents EducationalContent[]

  @@index([groupId, sessionDate, startTime], map: "idx_group_session_datetime")
  @@index([groupId, sessionDate], map: "idx_sessions_group_date")
  @@index([scheduleId], map: "idx_sessions_schedule")
  @@map("lesson_sessions")
}

model AttendanceRecord {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  sessionId       String           @map("session_id") @db.Uuid
  studentId       String           @map("student_id") @db.Uuid
  status          AttendanceStatus @map("status")
  recordingMethod RecordingMethod  @default(MANUAL) @map("recording_method")
  recordedById    String           @map("recorded_by_id") @db.Uuid
  recordedAt      DateTime         @default(now()) @map("recorded_at") @db.Timestamptz(6)
  notes           String?          @map("notes") @db.Text

  session    LessonSession  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  recordedBy User           @relation("RecordedAttendances", fields: [recordedById], references: [id], onDelete: Restrict)

  @@unique([sessionId, studentId], map: "uq_session_student")
  @@index([studentId, status], map: "idx_attendance_student_status")
  @@index([sessionId], map: "idx_attendance_session")
  @@index([recordedById], map: "idx_attendance_recorder")
  @@map("attendance_records")
}

// ==========================================
// 4. ONLINE LEARNING DOMAIN
// ==========================================

model Course {
  id            String       @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  teacherId     String       @map("teacher_id") @db.Uuid
  title         String       @map("title") @db.VarChar(255)
  description   String?      @map("description") @db.Text
  subject       String       @map("subject") @db.VarChar(100)
  gradeLevel    String       @map("grade_level") @db.VarChar(50)
  academicStage String?      @map("academic_stage") @db.VarChar(50)
  academicYear  String?      @default("2026-2027") @map("academic_year") @db.VarChar(30)
  academicTerm  String?      @default("FIRST_TERM") @map("academic_term") @db.VarChar(30)
  price         Decimal      @default(0.00) @map("price") @db.Decimal(10, 2)
  coverImageUrl String?      @map("cover_image_url") @db.Text
  status        CourseStatus @default(DRAFT) @map("status")
  orderIndex                  Int          @default(0) @map("order_index")
  enforceSequentialLessons    Boolean      @default(false) @map("enforce_sequential_lessons")
  courseQuizId  String?      @unique(map: "uq_course_quiz") @map("course_quiz_id") @db.Uuid
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher    TeacherProfile      @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  courseQuiz Assessment?         @relation("CourseFinalQuiz", fields: [courseQuizId], references: [id], onDelete: SetNull)

  modules     CourseModule[]
  enrollments CourseEnrollment[]
  groupAccess GroupCourseAccess[]
  assessments Assessment[]

  @@index([teacherId], map: "idx_courses_teacher")
  @@index([status, gradeLevel], map: "idx_courses_status_grade")
  @@map("courses")
}

model CourseModule {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  courseId    String   @map("course_id") @db.Uuid
  title       String   @map("title") @db.VarChar(255)
  description String?  @map("description") @db.Text
  orderIndex  Int      @map("order_index")
  unitQuizId  String?  @unique(map: "uq_unit_quiz") @map("unit_quiz_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  course   Course      @relation(fields: [courseId], references: [id], onDelete: Cascade)
  unitQuiz Assessment? @relation("UnitQuiz", fields: [unitQuizId], references: [id], onDelete: SetNull)

  lessons CourseLesson[]

  @@unique([courseId, orderIndex], map: "uq_course_module_order")
  @@index([courseId, orderIndex], map: "idx_modules_course_order")
  @@map("course_modules")
}

model CourseLesson {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  moduleId             String   @map("module_id") @db.Uuid
  title                String   @map("title") @db.VarChar(255)
  description          String?  @map("description") @db.Text
  summary              String?  @map("summary") @db.Text
  orderIndex           Int      @map("order_index")
  lessonType           String   @default("VIDEO") @map("lesson_type") @db.VarChar(50)
  videoAssetId         String?  @map("video_asset_id") @db.VarChar(255)
  bunnyVideoId         String?  @map("bunny_video_id") @db.VarChar(255)
  contentUrl           String?  @map("content_url") @db.Text
  videoDurationSeconds Int?     @map("video_duration_seconds")
  isPreview            Boolean  @default(false) @map("is_preview")
  lessonQuizId         String?  @unique(map: "uq_lesson_quiz") @map("lesson_quiz_id") @db.Uuid
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  module     CourseModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lessonQuiz Assessment?  @relation("LessonQuiz", fields: [lessonQuizId], references: [id], onDelete: SetNull)

  attachments         LessonAttachment[]
  questions           LessonQuestion[]
  progresses          CourseProgress[]
  educationalContents EducationalContent[]
  assessments         Assessment[]

  @@unique([moduleId, orderIndex], map: "uq_module_lesson_order")
  @@index([moduleId, orderIndex], map: "idx_lessons_module_order")
  @@map("course_lessons")
}

model LessonAttachment {
  id        String       @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  title     String       @map("title") @db.VarChar(255)
  fileUrl   String       @map("file_url") @db.Text
  fileKey   String       @map("file_key") @db.VarChar(500)
  fileSize  Int?         @map("file_size")
  fileType  String?      @map("file_type") @db.VarChar(100)
  lessonId  String       @map("lesson_id") @db.Uuid
  lesson    CourseLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  createdAt DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([lessonId], map: "idx_attachments_lesson")
  @@map("lesson_attachments")
}

model LessonQuestion {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  content        String                @map("content") @db.Text
  videoTimestamp Int?                  @map("video_timestamp")
  lessonId       String                @map("lesson_id") @db.Uuid
  lesson         CourseLesson          @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  studentId      String                @map("student_id") @db.Uuid
  student        StudentProfile        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  replies        LessonQuestionReply[]
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@index([lessonId, videoTimestamp], map: "idx_lesson_questions_timestamp")
  @@index([studentId], map: "idx_lesson_questions_student")
  @@map("lesson_questions")
}

model LessonQuestionReply {
  id         String         @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  content    String         @map("content") @db.Text
  questionId String         @map("question_id") @db.Uuid
  question   LessonQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)
  authorId   String         @map("author_id") @db.Uuid
  authorRole UserRole       @map("author_role")
  authorName String         @map("author_name") @db.VarChar(200)
  createdAt  DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([questionId], map: "idx_question_replies_question")
  @@map("lesson_question_replies")
}

model GroupCourseAccess {
  id        String        @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  courseId  String        @map("course_id") @db.Uuid
  groupId   String        @map("group_id") @db.Uuid
  course    Course        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  group     AcademicGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([courseId, groupId], map: "uq_group_course_access")
  @@index([groupId], map: "idx_group_course_access_group")
  @@index([courseId], map: "idx_group_course_access_course")
  @@map("group_course_access")
}

model CourseEnrollment {
  id         String                 @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  courseId   String                 @map("course_id") @db.Uuid
  studentId  String                 @map("student_id") @db.Uuid
  enrolledAt DateTime               @default(now()) @map("enrolled_at") @db.Timestamptz(6)
  status     CourseEnrollmentStatus @default(ACTIVE) @map("status")

  course  Course         @relation(fields: [courseId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)

  access CourseAccess?

  @@unique([courseId, studentId], map: "uq_course_student")
  @@index([studentId, status], map: "idx_course_enrollments_student")
  @@index([courseId, status], map: "idx_course_enrollments_course")
  @@map("course_enrollments")
}

model CourseAccess {
  id           String             @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  enrollmentId String             @unique(map: "uq_access_enrollment") @map("enrollment_id") @db.Uuid
  studentId    String             @map("student_id") @db.Uuid
  courseId     String             @map("course_id") @db.Uuid
  accessStatus CourseAccessStatus @default(ACTIVE) @map("access_status")
  validFrom    DateTime           @default(now()) @map("valid_from") @db.Timestamptz(6)
  validUntil   DateTime?          @map("valid_until") @db.Timestamptz(6)
  grantedById  String?            @map("granted_by_id") @db.Uuid
  createdAt    DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  enrollment CourseEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  grantedBy  User?            @relation("GrantedCourseAccesses", fields: [grantedById], references: [id], onDelete: SetNull)

  @@index([studentId, accessStatus], map: "idx_course_access_student")
  @@index([courseId, accessStatus], map: "idx_course_access_course")
  @@index([grantedById], map: "idx_course_access_grantor")
  @@map("course_access")
}

model CourseProgress {
  id                  String    @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  lessonId            String    @map("lesson_id") @db.Uuid
  studentId           String    @map("student_id") @db.Uuid
  courseId            String    @map("course_id") @db.Uuid
  lastPositionSeconds Int       @default(0) @map("last_position_seconds")
  isCompleted         Boolean   @default(false) @map("is_completed")
  firstAccessedAt     DateTime  @default(now()) @map("first_accessed_at") @db.Timestamptz(6)
  completedAt         DateTime? @map("completed_at") @db.Timestamptz(6)
  lastSyncedAt        DateTime  @default(now()) @map("last_synced_at") @db.Timestamptz(6)
  clientOperationId   String?   @map("client_operation_id") @db.Uuid

  lesson  CourseLesson   @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([lessonId, studentId], map: "uq_lesson_student_progress")
  @@index([studentId, courseId], map: "idx_course_progress_student")
  @@index([lessonId], map: "idx_course_progress_lesson")
  @@map("course_progress")
}

// ==========================================
// 5. SHARED EDUCATIONAL ASSETS & PROGRESS
// ==========================================

model EducationalContent {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  teacherId   String      @map("teacher_id") @db.Uuid
  groupId     String?     @map("group_id") @db.Uuid
  lessonId    String?     @map("lesson_id") @db.Uuid
  title        String      @map("title") @db.VarChar(255)
  description  String?     @map("description") @db.Text
  contentType  ContentType @map("content_type")
  fileKey      String      @map("file_key") @db.VarChar(500)
  fileUrl      String      @map("file_url") @db.Text
  fileSize     BigInt?     @map("file_size")
  mimeType     String?     @map("mime_type") @db.VarChar(100)
  gradeLevel   String?     @map("grade_level") @db.VarChar(50)
  academicYear String?     @default("2026-2027") @map("academic_year") @db.VarChar(30)
  academicTerm String?     @default("FIRST_TERM") @map("academic_term") @db.VarChar(30)
  sessionTopic String?     @map("session_topic") @db.VarChar(255)
  sessionId    String?     @map("session_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime    @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  group   AcademicGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  lesson  CourseLesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  session LessonSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  progresses ContentProgress[]

  @@index([groupId, contentType], map: "idx_content_group_type")
  @@index([lessonId, contentType], map: "idx_content_lesson_type")
  @@index([teacherId], map: "idx_content_teacher")
  @@index([gradeLevel, academicYear, academicTerm], map: "idx_content_grade_year_term")
  @@index([sessionId], map: "idx_content_session")
  @@map("educational_content")
}

model ContentProgress {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  contentId     String   @map("content_id") @db.Uuid
  studentId     String   @map("student_id") @db.Uuid
  firstViewedAt DateTime @default(now()) @map("first_viewed_at") @db.Timestamptz(6)
  lastViewedAt  DateTime @default(now()) @map("last_viewed_at") @db.Timestamptz(6)
  viewCount     Int      @default(1) @map("view_count")
  isCompleted   Boolean  @default(false) @map("is_completed")

  content EducationalContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  student StudentProfile     @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([contentId, studentId], map: "uq_content_student")
  @@index([studentId], map: "idx_progress_student")
  @@index([contentId], map: "idx_progress_content")
  @@map("content_progress")
}

// ==========================================
// 6. ASSESSMENTS, EXAMS & SUBMISSIONS
// ==========================================

model Assessment {
  id              String         @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  teacherId       String         @map("teacher_id") @db.Uuid
  groupId         String?        @map("group_id") @db.Uuid
  courseId        String?        @map("course_id") @db.Uuid
  lessonId        String?        @map("lesson_id") @db.Uuid
  academicStage   String?        @map("academic_stage") @db.VarChar(50)
  gradeLevel      String?        @map("grade_level") @db.VarChar(50)
  title           String         @map("title") @db.VarChar(255)
  description     String?        @map("description") @db.Text
  type            AssessmentType @map("type")
  totalScore      Decimal        @default(100.00) @map("total_score") @db.Decimal(6, 2)
  passingScore    Decimal?       @map("passing_score") @db.Decimal(6, 2)
  durationMinutes Int?           @map("duration_minutes")
  isAutoGraded    Boolean        @default(false) @map("is_auto_graded")
  isPublished     Boolean        @default(true) @map("is_published")
  startDate       DateTime?      @map("start_date") @db.Timestamptz(6)
  dueDate         DateTime?      @map("due_date") @db.Timestamptz(6)
  createdAt       DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  group   AcademicGroup? @relation(fields: [groupId], references: [id], onDelete: Cascade)
  targetGroups AcademicGroup[] @relation("AssessmentTargetGroups")
  course  Course?        @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson  CourseLesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  courseFinalQuizOf Course?       @relation("CourseFinalQuiz")
  unitQuizOf        CourseModule? @relation("UnitQuiz")
  lessonQuizOf      CourseLesson? @relation("LessonQuiz")

  questions   AssessmentQuestion[]
  submissions AssessmentSubmission[]

  @@index([groupId, type], map: "idx_assessments_group_type")
  @@index([courseId, type], map: "idx_assessments_course_type")
  @@index([lessonId, type], map: "idx_assessments_lesson_type")
  @@index([teacherId], map: "idx_assessments_teacher")
  @@map("assessments")
}

model AssessmentQuestion {
  id             String       @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  assessmentId   String       @map("assessment_id") @db.Uuid
  questionNumber Int          @map("question_number")
  questionText   String       @map("question_text") @db.Text
  questionType   QuestionType @map("question_type")
  optionsData    Json?        @map("options_data")
  correctAnswer  String       @map("correct_answer") @db.Text
  explanation    String?      @map("explanation") @db.Text
  imageUrl       String?      @map("image_url") @db.Text
  points         Decimal      @default(1.00) @map("points") @db.Decimal(5, 2)

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  studentAnswers StudentAnswer[]

  @@unique([assessmentId, questionNumber], map: "uq_assessment_question")
  @@index([assessmentId], map: "idx_questions_assessment")
  @@map("assessment_questions")
}

model AssessmentSubmission {
  id              String           @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  assessmentId    String           @map("assessment_id") @db.Uuid
  studentId       String           @map("student_id") @db.Uuid
  status          SubmissionStatus @default(SUBMITTED) @map("status")
  submittedAt     DateTime         @default(now()) @map("submitted_at") @db.Timestamptz(6)
  attachmentUrl   String?          @map("attachment_url") @db.Text
  scoreObtained   Decimal?         @map("score_obtained") @db.Decimal(6, 2)
  isAutoGraded    Boolean          @default(false) @map("is_auto_graded")
  gradedAt        DateTime?        @map("graded_at") @db.Timestamptz(6)
  teacherFeedback String?          @map("teacher_feedback") @db.Text

  assessment Assessment     @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)

  answers StudentAnswer[]

  @@unique([assessmentId, studentId], map: "uq_assessment_student")
  @@index([assessmentId, status], map: "idx_submissions_assessment_status")
  @@index([studentId], map: "idx_submissions_student")
  @@map("assessment_submissions")
}

model StudentAnswer {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  submissionId      String   @map("submission_id") @db.Uuid
  questionId        String   @map("question_id") @db.Uuid
  selectedAnswer    String?  @map("selected_answer") @db.Text
  isCorrect         Boolean? @map("is_correct")
  pointsEarned      Decimal? @map("points_earned") @db.Decimal(5, 2)
  maxPointsSnapshot Decimal? @default(1.00) @map("max_points_snapshot") @db.Decimal(5, 2)
  teacherFeedback   String?  @map("teacher_feedback") @db.Text

  submission AssessmentSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  question   AssessmentQuestion   @relation(fields: [questionId], references: [id], onDelete: Restrict)

  @@unique([submissionId, questionId], map: "uq_submission_question")
  @@index([questionId], map: "idx_answers_question")
  @@index([submissionId], map: "idx_answers_submission")
  @@map("student_answers")
}

// ==========================================
// 7. EVALUATIONS, NOTIFICATIONS & PAYMENTS
// ==========================================

model StudentEvaluation {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  studentId      String   @map("student_id") @db.Uuid
  teacherId      String   @map("teacher_id") @db.Uuid
  groupId        String?  @map("group_id") @db.Uuid
  evaluationDate DateTime @default(now()) @map("evaluation_date") @db.Date
  studentLevel   String?  @map("student_level") @db.VarChar(50)
  teacherNotes   String   @map("teacher_notes") @db.Text
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  student StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  teacher TeacherProfile @relation(fields: [teacherId], references: [id], onDelete: Restrict)
  group   AcademicGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([studentId, evaluationDate], map: "idx_evaluations_student_date")
  @@index([teacherId, groupId], map: "idx_evaluations_teacher_group")
  @@map("student_evaluations")
}

model Notification {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  recipientId       String    @map("recipient_id") @db.Uuid
  type              String    @map("type") @db.VarChar(50)
  title             String    @map("title") @db.VarChar(255)
  message           String    @map("message") @db.Text
  referenceEntityId String?   @map("reference_entity_id") @db.Uuid
  isRead            Boolean   @default(false) @map("is_read")
  readAt            DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  recipient User @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([recipientId, isRead, createdAt], map: "idx_notifications_recipient_read")
  @@map("notifications")
}

model Booklet {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  title            String          @map("title") @db.VarChar(255)
  price            Decimal         @map("price") @db.Decimal(10, 2)
  gradeLevel       String          @map("grade_level") @db.VarChar(50)
  groupId          String?         @map("group_id") @db.Uuid
  group            AcademicGroup?  @relation(fields: [groupId], references: [id], onDelete: SetNull)
  teacherProfileId String          @map("teacher_profile_id") @db.Uuid
  teacherProfile   TeacherProfile  @relation(fields: [teacherProfileId], references: [id], onDelete: Cascade)
  academicYear     String?         @default("2026-2027") @map("academic_year") @db.VarChar(30)
  academicTerm     String?         @default("FIRST_TERM") @map("academic_term") @db.VarChar(30)
  stockCount       Int?            @map("stock_count")
  isActive         Boolean         @default(true) @map("is_active")
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)

  payments         StudentPaymentRecord[]

  @@index([teacherProfileId, gradeLevel], map: "idx_booklets_teacher_grade")
  @@index([groupId], map: "idx_booklets_group")
  @@map("booklets")
}

model StudentPaymentRecord {
  id             String        @id @default(dbgenerated("gen_random_uuid()")) @map("id") @db.Uuid
  studentId      String        @map("student_id") @db.Uuid
  groupId        String?       @map("group_id") @db.Uuid
  periodYear     Int           @map("period_year") @db.SmallInt
  periodMonth    Int           @map("period_month") @db.SmallInt
  amountExpected Decimal       @default(0.00) @map("amount_expected") @db.Decimal(10, 2)
  amountPaid     Decimal       @default(0.00) @map("amount_paid") @db.Decimal(10, 2)
  currency       String        @default("EGP") @map("currency") @db.VarChar(10)
  paymentType    PaymentType   @default(TUITION) @map("payment_type")
  bookletId      String?       @map("booklet_id") @db.Uuid
  paymentStatus  PaymentStatus @default(PENDING) @map("payment_status")
  paymentMethod  String        @default("CASH") @map("payment_method") @db.VarChar(50)
  receiptNumber  String?       @map("receipt_number") @db.VarChar(100)
  recordedById   String        @map("recorded_by_id") @db.Uuid
  notes          String?       @map("notes") @db.Text
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)

  student    StudentProfile @relation(fields: [studentId], references: [id], onDelete: Restrict)
  group      AcademicGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)
  booklet    Booklet?       @relation(fields: [bookletId], references: [id], onDelete: SetNull)
  recordedBy User           @relation("RecordedPayments", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([studentId, groupId, periodYear, periodMonth], map: "idx_student_group_billing_period")
  @@index([studentId], map: "idx_payments_student")
  @@index([bookletId], map: "idx_payments_booklet")
  @@index([recordedById, groupId], map: "idx_payments_recorder_group")
  @@map("student_payment_records")
}
