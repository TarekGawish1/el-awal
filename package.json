{
  "name": "el-awal-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=@el-awal/web",
    "dev:backend": "npm run dev --workspace=@el-awal/backend",
    "build:web": "npm run build --workspace=@el-awal/web",
    "build:backend": "npm run build --workspace=@el-awal/backend",
    "build": "npm run build --workspaces --if-present",
    "test:web": "npm run test --workspace=@el-awal/web",
    "test:backend": "npm run test --workspace=@el-awal/backend",
    "prisma:generate": "npm run prisma:generate --workspace=@el-awal/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=@el-awal/backend",
    "prisma:migrate:deploy": "npm run prisma:migrate:deploy --workspace=@el-awal/backend",
    "prisma:studio": "npm run prisma:studio --workspace=@el-awal/backend"
  }
}
