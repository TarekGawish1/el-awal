{
  "name": "el-awal-monorepo",
  "version": "1.0.1",
  "private": true,
  "workspaces": [
    "apps/*"
  ],
  "packageManager": "bun@1.4.2",
  "scripts": {
    "dev": "bun run dev:web",
    "dev:all": "bun -e \"const { spawn } = require('child_process'); const p1 = spawn('bun', ['run', 'dev:backend'], { stdio: 'inherit', shell: true }); const p2 = spawn('bun', ['run', 'dev:web'], { stdio: 'inherit', shell: true }); process.on('SIGINT', () => { p1.kill(); p2.kill(); process.exit(); });\"",
    "dev:web": "bun --filter @el-awal/web dev",
    "dev:backend": "bun --filter @el-awal/backend dev",
    "dev:platform": "bun --filter @el-awal/platform dev",
    "build:web": "bun --filter @el-awal/web build",
    "build:backend": "bun --filter @el-awal/backend build",
    "build:platform": "bun --filter @el-awal/platform build",
    "build": "bun run build:backend && bun run build:web",
    "test": "bun run test:web && bun run test:backend",
    "test:web": "bun --filter @el-awal/web test",
    "test:backend": "bun --filter @el-awal/backend test",
    "test:platform": "bun --filter @el-awal/platform test",
    "prisma:generate": "bun --filter @el-awal/backend prisma:generate",
    "prisma:migrate": "bun --filter @el-awal/backend prisma:migrate",
    "prisma:migrate:deploy": "bun --filter @el-awal/backend prisma:migrate:deploy",
    "prisma:db:push": "bun x prisma db push --schema apps/backend/prisma/schema.prisma --accept-data-loss",
    "prisma:studio": "bun --filter @el-awal/backend prisma:studio"
  },
  "overrides": {
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "multer": "2.5.0",
    "fastify": "5.12.6",
    "@grpc/grpc-js": "1.14.6"
  },
  "dependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  }
}
